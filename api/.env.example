# Copy to .env and fill in. .env is auto-loaded.

# HTTP server
LISTEN_ADDR=:8080
WEB_ORIGIN=http://localhost:3000

# MySQL — same database used by ../scryfall/load_scryfall.py
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mtgrealm
MYSQL_PASSWORD=mtgrealm
MYSQL_DATABASE=mtgrealm

# Auth
# Set COOKIE_SECURE=false during local http dev; true under https.
COOKIE_SECURE=false
COOKIE_DOMAIN=
SESSION_TTL_HOURS=720

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys).
# STRIPE_WEBHOOK_SECRET comes from `stripe listen --forward-to localhost:8080/api/v1/stripe/webhook`
# during local dev (Stripe CLI emits it on stdout).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_CURRENCY=USD
